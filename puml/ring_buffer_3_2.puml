@startuml
' Ring buffer & WindowReady ticks (Section 3.2)
skinparam defaultFontName Helvetica
title Ring buffer and windowed ticks

participant "Acquisition Manager" as ACQ
participant "Ring Buffer\n(L = ceil(win_s * sr_hz) per channel)" as RB
participant "Reactive Graph" as RX

ACQ -> RB : append(chunk: data[n_s × n_ch], ts_src, sr_hz)
note right of RB
  Keeps last L samples per channel
  L = ceil(win_s * sr_hz)
end note

== Tick cadence ==
ACQ -> RX : WindowReady(win_s, overlap, t_start_src, t_end_src)
note over ACQ,RX
  hop_s = win_s * (1 - overlap)\n(e.g., win_s=5s, 50%→2.5s; 80%→1.0s)
end note

RB -> RX : view(last L samples × n_ch)
@enduml
