
@startuml
title RBciAD — Object diagram (runtime example)
skinparam backgroundColor #FFFFFF
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #222222
left to right direction

object editor : NodeEditor
object rx : ReactiveEngine
object reader : EEGUniversalReader {
  sr_hz = 200.0
  ch_names = [Fz, Cz, Pz, Oz, ...]
}
object filt : EEGFilter {
  band = [1, 40] Hz
  notch = 50 Hz
}
object disp : EEGLiveDisplay {
  window = 5 s
}
object wrapper : PolyglotWrapper
object ext : ExternalExec

editor --> rx : onChange(...)
rx --> reader : stream()
reader --> filt : segments
filt --> disp : segments_filtered
rx ..> wrapper : call()
wrapper ..> ext : process
@enduml
