@startuml
' Reactive propagation and metrics timing
skinparam defaultFontName Helvetica
title Propagation & Timing — TTFP and Edit-to-Redraw Latency

actor User
participant "UI (LiveDisplay controls)" as UI
participant "Rx Engine" as RX
participant "Renderer" as R

== TTFP ==
User -> UI : (F9) START_TTFP
UI -> RX : START_TTFP(t_start)
... pipeline boots, first draw ...
RX -> R : FIRST_FRAME(t_first)
note over UI,R
  TTFP = t_first - t_start
end note

== Edit-to-redraw latency ==
User -> UI : PARAM_CHANGE (version u_k, t_k^pc)
UI -> RX : propagate(u_k)
RX -> R : FRAME (applied v_j ≥ u_k, t_j^fr)
note over UI,R
  Δt_k = t_j^fr - t_k^pc
end note

== Continuous counters ==
R -> R : FPS counters, dropped%
RX -> RX : SAMPLES_IN (cumulative)

@enduml
