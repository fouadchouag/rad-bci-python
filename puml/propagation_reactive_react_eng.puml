@startuml
hide footbox
skinparam wrapWidth 160

actor User
participant "No-code Editor\n(Node Graph)" as Editor
participant "Reactive Engine (RxPy)" as Rx
participant "EEGFilter" as Filter
participant "EEGLiveDisplay" as LiveDisplay
participant "Metrics Logger\n(eval_log)" as MLog

User -> Editor : Ajuste cutoff (ex. LP=40 Hz)
Editor -> Rx : onChange(pin=filter.cutoff, value=40)
Rx -> Filter : set_input(cutoff=40)\n(trigger execute)
Filter -> Rx : emit(output=segments_filtered)
Rx -> LiveDisplay : set_input(segments=...)\n(trigger redraw)
LiveDisplay -> LiveDisplay : redraw()  // frame rendered

... instrumentation ...
Rx -> MLog : PARAM_CHANGE, ts
LiveDisplay -> MLog : FIRST_FRAME after change, ts
MLog -> MLog : compute latency (P50/P95)
@enduml
