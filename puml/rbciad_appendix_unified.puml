@startuml
' RBciAD — Unified Appendix Diagram (Architecture + Windowing + Latency)
skinparam defaultFontName Helvetica
skinparam rectangle {
  RoundCorner 12
  BorderColor #333333
  BackgroundColor #f8f9fa
}
skinparam packageStyle rectangle

title RBciAD — System Overview (with Windowing & Latency Definitions)

package "Host Process (Python / PyQt)" #e8f0fe {
  rectangle "UI (PyQt)\n• Node Graph Editor\n• LiveDisplay\n• Low-code Editor" as UI
  rectangle "Reactive Engine (RxPy)\n• NodeGraph / Edges\n• Propagation / caching" as RX #eaf7ea
  rectangle "Plugin Manager\n• Discovery (plugins/, custom_plugins/)\n• Registration / palette" as PM
  rectangle "Acquisition Manager\n• Sources\n• Ring Buffer\n• Event Bus" as ACQ
  rectangle "Python Nodes (in-process)\nEEGReader, Filter, FeatureExtractor,\nClassifierTrainer, PredictionVisualizer" as NPY
  rectangle "External Wrapper\n• JSON I/O (input.json/output.json)\n• Timeout / exit code / stderr tail" as WRAP #fff3cd
  rectangle "Metrics Logger\nCSV events: START_TTFP, FIRST_FRAME,\nPARAM_CHANGE, FRAME, SAMPLES_IN, CPU, RSS" as LOG
}

package "External Process (per node)" #fff3cd {
  rectangle "External Node\n(C/C++/Rust/Node.js)\nreads input.json → writes output.json" as NEXT
}

package "Sources" {
  rectangle "EDF/BDF (MNE)" as EDF
  rectangle "LSL (pylsl)" as LSL
}

EDF -down-> ACQ
LSL -down-> ACQ
ACQ -right-> RX : chunks (n_s×n_ch, sr_hz, ch_names, ts_src)\nWindowReady(win_s, hop_s)
RX -down-> NPY
RX -down-> WRAP
WRAP -down-> NEXT : spawn / JSON exchange
RX -right-> UI : frames (windowed)
UI -right-> LOG : renderer counters
ACQ -down-> LOG : SAMPLES_IN
RX -right-> LOG : PARAM_CHANGE, FRAME
UI -left-> PM : palette refresh
PM -down-> NPY : register()
PM -down-> WRAP : register()

' --- Windowing / Ring buffer note ---
note right of ACQ
  **Windowing & Ring Buffer**
  L = ceil(win_s × sr_hz)  (samples per channel)
  hop_s = win_s × (1 − overlap),
  with overlap ∈ [0,1) (e.g., 0.5 = 50%).
  Each WindowReady tick provides
  the last L samples per channel and
  (t_start_src, t_end_src) of the window.
end note

' --- Versioned propagation & latency note ---
note bottom of RX
  **Versioned propagation & latency**
  Each edit k: PARAM_CHANGE at t_k^pc with config_version u_k.
  Frames j have timestamps t_j^fr and applied_version v_j.
  Per-edit latency:
    Δt_k = min_{j: t_j^fr > t_k^pc, v_j ≥ u_k} ( t_j^fr − t_k^pc ).
  TTFP = t^first − t^start (FIRST_FRAME − START_TTFP).
end note

legend right
  Solid arrows = data/control flow
  Dashed boundary = process isolation (external nodes)
  LOG collects metrics for §5.3 (TTFP, P50/P95, FPS, Throughput,
  Dropped %, CPU/RSS), rebuilt from CSVs via metric_eval.py
end legend
@enduml
