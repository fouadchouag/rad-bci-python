@startuml
' Versioned propagation across nodes (Reactive engine)
skinparam defaultFontName Helvetica
title Versioned propagation — config_version u_k, applied_version v_j

actor User
participant "UI (controls)" as UI
participant "Node A" as A
participant "Node B" as B
participant "Renderer" as R

User -> UI : PARAM_CHANGE (u_k, t_k^pc)
UI -> A : set_params(u_k)
A -> B : publish(version=u_k, dataA)
B -> R : publish(version=u_k, dataB)
R -> R : draw(frame, applied_version=v_j=u_k, t_j^fr)
note over UI,R
  First frame with v_j ≥ u_k defines Δt_k
end note

== Selective recomputation ==
User -> UI : PARAM_CHANGE (u_{k+1} affects A only)
UI -> A : set_params(u_{k+1})
A -> B : publish(version=u_{k+1}, dataA')
B -> R : publish(version=u_{k+1}, cached+update)
@enduml
