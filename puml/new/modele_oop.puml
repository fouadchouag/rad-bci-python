@startuml
hide circle
skinparam classAttributeIconSize 0

class Graph {
  +addNode(n: Node)
  +connect(a: Pin, b: Pin)
}

class Node {
  +id: str
  +name: str
  +plugin: Plugin
  +pinsIn: List<Pin>
  +pinsOut: List<Pin>
}

class Pin {
  +name: str
  +type: str
  +direction: enum{IN,OUT}
}

class Connection {
  +from: Pin
  +to: Pin
}

abstract class Plugin {
  +setup()
  +execute(inputs)->outputs
}

class ReactiveNode extends Plugin {
  -subsIn: Map<str,Subject>
  -subsOut: Map<str,Subject>
}

class PolyglotPlugin extends Plugin {
  -execPath: str
  -buildCommand(): List<str>
}

class Registry {
  +discover()
  +create(name)->Plugin
}

class MetricsLogger {
  +log(event: str, ts: int)
}

Graph "1" o-- "*" Node
Node "1" o-- "*" Pin
Connection "*" -- "1" Pin : from
Connection "*" -- "1" Pin : to
Node "1" *-- "1" Plugin
Graph "*" o-- "*" Connection
Registry ..> Plugin
ReactiveNode ..|> Plugin
PolyglotPlugin ..|> Plugin
Plugin ..> MetricsLogger
@enduml
