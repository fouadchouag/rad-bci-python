@startuml
actor User
participant "Node Editor" as UI
participant "Reactive Engine" as RX
participant "Upstream Node" as U
participant "Downstream Node" as D
participant "Metrics" as M

User -> UI : Param change
UI -> RX : onChange(pin,value)
RX -> U : set_input(...)
U -> RX : emit(output)
RX -> D : set_input(...)
D -> D : execute()
D -> RX : emit(...)
RX -> M : events/timestamps
@enduml
