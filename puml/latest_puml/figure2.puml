@startuml
skinparam backgroundColor #FFFFFF
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #222222
left to right direction

' --- Sources côté acquisition ---
node "Physical EEG device\n(OpenBCI / g.tec / Muse)\n<<device>>" as dev
node "LSL equipment\n(EEG amplifier)\n<<device>>" as lsl_dev
node "Signal simulator / emulator\n(LSL or replay)" as sim
file "EDF / BDF / GDF files" as files

cloud "LSL network" as lsl_net

' --- RBciAD hôte ---
node "Laptop / Workstation" as host {
  node "RBciAD host (Python)" as app {
    component "Acquisition Manager" as AM
    component "Event Bus" as BUS
    component "Reactive Engine (RxPy)" as RX
  }
}

' --- Flux d'entrée vers AM ---
dev --> lsl_net : stream (planned / via SDK)
lsl_dev --> lsl_net : LSL stream
sim --> lsl_net : synthetic LSL
lsl_net --> AM : subscribe(stream)
files --> AM : file replay (MNE)

' --- Artefact de sortie unifié ---
artifact "Unified chunk {\n  data[n_s,n_ch],\n  sr_hz,\n  ch_names,\n  ts_src\n}" as CH

AM --> CH : normalize()
AM --> BUS : WindowReady(win)
BUS --> RX : window ticks

note right of AM
L = ceil(win_s * sr_hz)
hop_s = win_s * (1 - overlap)
ticks every hop_s (WindowReady)
end note

note right of lsl_net
ts_src from source clock;
LSL host-source offset monitored
end note
@enduml
