@startuml
title Figure 3 (alt) - Node editor core classes

skinparam backgroundColor #FFFFFF
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #222222
left to right direction

class NodeEditor {
  +graph: Graph
  +addNode(n: Node): void
  +connect(a: Pin, b: Pin): void
}

class Graph {
  +nodes: List<Node>
  +connections: List<Connection>
  +onChange(event): void
}

class Node {
  +id: int
  +name: str
  +params: dict
  +inPins: List<Pin>
  +outPins: List<Pin>
  +execute(): void
}

class Pin {
  +name: str
  +type: str  ' e.g., Raw, Segments, Float
  +dir: str   ' in | out
}

class Connection {
  +from: Pin
  +to: Pin
}

class ParameterWidget {
  +key: str
  +value: any
  +bind(node: Node): void
}

class ReactiveEngine {
  +propagate(node: Node): void
}

NodeEditor o-- Graph
Graph o-- Node
Node "1" o-- "0..*" Pin : inPins/outPins
Graph o-- Connection
ParameterWidget --> Node : edits params
ReactiveEngine ..> Node : executes
Graph --> ReactiveEngine : onChange()

note right of ParameterWidget
In-node controls (sliders,
checkboxes, text fields)
end note

note right of Pin
Typed pins carry a lightweight
type tag (e.g., Raw/Segments)
end note

@enduml
