@startuml
title Figure 3 - No-code node editor: example DAG
skinparam backgroundColor #FFFFFF
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #222222
left to right direction

package "Editor Canvas (QGraphicsView)" {
  object "EEGReader\n(reader)" as reader {
    out: Raw (MNE Raw)
    params: file=demo.edf
  }

  object "EEGFilter\n(filter)" as filter {
    in: Raw
    params: band=[1,40] Hz; notch=50 Hz
    out: Segments
  }

  object "EEGLiveDisplay\n(display)" as display {
    in: Segments
    params: window=5 s; scale=per-channel
  }

  reader --> filter : Raw stream
  filter --> display : Windowed segments
}

note right of filter
Typed pins:
- in: Raw
- out: Segments
In-node parameter widgets
end note

note right of display
Edits propagate instantly
(no "Run" button")
end note
@enduml
