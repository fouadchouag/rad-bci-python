
@startuml
skinparam backgroundColor #FFFFFF
skinparam dpi 130
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #222222
skinparam componentStyle rectangle
skinparam ArrowThickness 1.1
skinparam Rectangle {
  RoundCorner 12
}
left to right direction
scale 0.75

' -------- Row 1 (main flow) --------
rectangle "Developer" as DEV
rectangle "Low-Code Creator" as LCC
rectangle "Registry / Loader" as REG
rectangle "Palette [Custom]" as PAL

DEV --> LCC : config
LCC --> REG : generate + refresh
REG --> PAL : register

' -------- Row 2 (compact aux blocks) --------
rectangle "custom_plugins/" as CPL
rectangle "Node Help (auto)" as HELP

LCC -down-> CPL : skeletons
LCC -down-> HELP : help stub

note right of REG
No restart; shared JSON I/O
Large arrays via file paths
end note
@enduml
