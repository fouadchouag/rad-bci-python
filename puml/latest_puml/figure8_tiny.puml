@startuml
skinparam backgroundColor #FFFFFF
skinparam dpi 100
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #222222
skinparam RectangleBorderColor #333333
skinparam ArrowThickness 1.0
top to bottom direction
scale 0.60

rectangle "Files\n(EDF/BDF/GDF/FIF/BV)" as FILES
rectangle "LSL" as LSL
rectangle "UniversalReader" as UREAD
rectangle "LSL-Reader" as LSLR
rectangle "Unified stream\n{data, sr_hz, ch_names, ts_src}" as STREAM
rectangle "LiveDisplay" as LIVE
rectangle "Saver\n(EDF/BDF/GDF/FIF/CSV)" as SAVER

FILES --> UREAD
LSL   --> LSLR
UREAD --> STREAM
LSLR  --> STREAM
STREAM --> LIVE
STREAM --> SAVER
@enduml
