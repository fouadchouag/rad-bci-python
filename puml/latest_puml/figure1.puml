@startuml
skinparam backgroundColor #FFFFFF
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #222222
skinparam packageStyle rectangle
left to right direction

package "GUI (PyQt)" {
  class NodeEditor
}

package "Engine (RxPy)" {
  class ReactiveEngine
}

package "Plugins" {
  class PythonPlugins
  class PolyglotWrapper
}

package "EEG I/O (MNE-Python)" {
  class EEGReader
  class LSLReader
}

package "Plotting (Matplotlib)" {
  class LiveDisplay
}

package "Formats / Streams" {
  class EDF_BDF_GDF_LSL <<external>>
}

' --- Main flows ---
NodeEditor --> ReactiveEngine : edits / graph
ReactiveEngine --> PythonPlugins : execute nodes
ReactiveEngine --> PolyglotWrapper : spawn external step
EEGReader --> ReactiveEngine : file stream
LSLReader --> ReactiveEngine : live stream
ReactiveEngine --> LiveDisplay : render traces
EDF_BDF_GDF_LSL --> EEGReader : files/streams
@enduml
