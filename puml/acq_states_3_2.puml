@startuml
' Acquisition Manager state machine
skinparam defaultFontName Helvetica
title Acquisition Manager — State Machine

[*] --> IDLE
IDLE --> PREPARED : prepare(source)
PREPARED --> RUNNING : start()
RUNNING --> PAUSED : pause()
PAUSED --> RUNNING : resume()
RUNNING --> STOPPED : stop()
STOPPED --> [*]
PREPARED --> STOPPED : teardown()
RUNNING --> STOPPED : error/teardown

note right of RUNNING
  Emits WindowReady ticks every hop_s
  Updates diagnostics on event bus
end note
@enduml
