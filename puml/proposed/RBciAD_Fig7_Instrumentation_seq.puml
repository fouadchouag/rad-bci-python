
@startuml
title Figure 7 — KPI instrumentation for edit-to-redraw

' --- Minimal, compact style for sequence diagrams ---
skinparam backgroundColor #FFFFFF
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName Arial
skinparam Participant {
  BackgroundColor #F7F7F7
  BorderColor #333333
}
skinparam ArrowColor #222222
skinparam NoteBackgroundColor #FAFAFA
skinparam NoteBorderColor #BBBBBB
skinparam SequenceMessageAlign center
scale 0.9


participant "Node Editor" as Editor
participant "Reactive Engine" as Rx
participant "EEGLiveDisplay" as Display
participant "Metrics Logger" as Log

Editor -> Rx: onChange(parameter edit)
Rx -> Display: set_input(...)
(trigger redraw)
Display -> Display: redraw()
Editor -> Log: PARAM_CHANGE_ts
Display -> Log: FIRST_FRAME_ts
Log -> Log: compute latency (P50/P95)

@enduml
