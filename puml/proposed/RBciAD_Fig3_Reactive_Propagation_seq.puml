
@startuml
title Figure 3 — Reactive propagation with RxPy (edit -> redraw)

' --- Minimal, compact style for sequence diagrams ---
skinparam backgroundColor #FFFFFF
skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName Arial
skinparam Participant {
  BackgroundColor #F7F7F7
  BorderColor #333333
}
skinparam ArrowColor #222222
skinparam NoteBackgroundColor #FAFAFA
skinparam NoteBorderColor #BBBBBB
skinparam SequenceMessageAlign center
scale 0.9


actor User
participant "Node Editor" as Editor
participant "Reactive Engine (RxPy)" as Rx
participant "EEGFilter" as Filter
participant "EEGLiveDisplay" as Display

User -> Editor: Adjust cutoff (e.g., LP=40 Hz)
Editor -> Rx: onChange(pin=filter.cutoff, value=40)
Rx -> Filter: set_input(cutoff=40)
(trigger execute)
Filter -> Rx: emit(output=segments_filtered)
Rx -> Display: set_input(segments=...)
(trigger redraw)
note over Rx
PARAM_CHANGE_ts recorded
end note
Display -> Display: redraw()
note over Display
FIRST_FRAME_ts after change
end note

@enduml
