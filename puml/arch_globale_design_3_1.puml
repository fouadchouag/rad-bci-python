@startuml
skinparam componentStyle rectangle
skinparam wrapWidth 180
left to right direction

package "RBciAD GUI" as GUI {
  [No-code Editor\n(Node Graph)] as Editor
  [Low-Code Creator] as LowCode
}

package "Execution Engine" as Engine {
  [Reactive Engine (RxPy)] as Rx
  [Plugin Registry & Loader] as Registry
  [Metrics Logger\n(eval_log)] as MLog
}

package "Python Plugins" as PyPlugs {
  [EEGUniversalReader] as Reader
  [EEGFilter] as Filter
  [EEGLiveDisplay] as LiveDisplay
}

package "Polyglot Bridge" as Poly {
  [PolyglotPlugin Wrapper] as Wrapper
  [External Script/Exe\n(Rust/C++/Node.js/R...)\nJSON I/O via subprocess] as ExtExe
}

package "I/O & Data" as IO {
  [Data Sources\n(EDF/BDF/GDF/LSL)] as Sources
  [Outputs & Sinks\n(Matplotlib plots,\n3D Topomap,\nWeb client,\nCSV)] as Sinks
  [metrics_eval.py (offline)] as Aggreg
}

Editor --> Rx : Graph edits\n+ param changes
Editor --> Registry : Palette, add node
Rx --> Registry : discover() / import

Rx --> Reader : subscribe/pull
Reader --> Filter : stream segments
Filter --> LiveDisplay : frames/segments

Rx --> Wrapper : JSON input
Wrapper ..> ExtExe : spawn + stdin/stdout\ninput.json / output.json
Wrapper --> Rx : JSON output

Sources --> Reader
LiveDisplay --> Sinks
Rx --> MLog : events + counters
MLog --> Sinks : run_*.csv
Sinks ..> Aggreg : aggregate → metrics_sample.csv

LowCode --> Registry : add custom plugin\n(généré dynamiquement)
@enduml
